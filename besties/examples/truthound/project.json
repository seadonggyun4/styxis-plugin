{
  "schema_version": 1,
  "product": {
    "id": "truthound-local",
    "name": "Truthound",
    "category": "Local data validation MCP backed by a data quality framework",
    "version": "Core 3.3.1 / Local 0.1.7"
  },
  "evidence": [
    {
      "id": "guide",
      "url": "https://truthound.netlify.app/en/guides/data-validation-mcp/",
      "label": "Published Local MCP guide",
      "visibility": "public"
    },
    {
      "id": "example",
      "url": "https://truthound.netlify.app/assets/examples/local-mcp-3.3.1.json",
      "label": "Synthetic Local execution receipt",
      "visibility": "public"
    }
  ],
  "claims": [
    {
      "id": "identity",
      "statement": "Truthound is a data quality framework. Truthound Local exposes a bounded set of local file checks through MCP.",
      "kind": "identity",
      "evidence": [
        "guide"
      ]
    },
    {
      "id": "checks",
      "statement": "Truthound Local checks missing values and duplicate rows in approved CSV and Parquet files.",
      "kind": "capability",
      "evidence": [
        "guide",
        "example"
      ]
    },
    {
      "id": "limits",
      "statement": "Local does not accept custom schema or rule inputs and does not establish compatibility with Great Expectations configuration formats.",
      "kind": "limitation",
      "evidence": [
        "guide"
      ]
    },
    {
      "id": "pii",
      "statement": "Local provides aggregate profiling and sampled PII screening; a clean screening result does not establish absence of PII.",
      "kind": "capability",
      "evidence": [
        "guide",
        "example"
      ]
    }
  ],
  "targets": [
    {
      "id": "docs-en",
      "url": "https://truthound.netlify.app/en/guides/data-validation-mcp/",
      "locale": "en",
      "required_terms": [
        "Truthound",
        "check_file",
        "profile_file",
        "scan_pii"
      ],
      "required_links": [
        "https://truthound.netlify.app/en/guides/local-mcp-example/"
      ]
    },
    {
      "id": "website-en",
      "url": "https://styxis-io.com/en/open-source/truthound",
      "locale": "en",
      "required_terms": [
        "Truthound",
        "check_file",
        "profile_file",
        "scan_pii"
      ],
      "required_links": [
        "https://truthound.netlify.app/en/guides/local-mcp-example/"
      ]
    }
  ],
  "queries": [
    {
      "id": "category",
      "text": "Which data quality frameworks offer local MCP tools when considering Great Expectations alternatives?",
      "split": "development",
      "intent": "category-and-mcp",
      "claims": [
        "identity",
        "checks",
        "limits"
      ]
    },
    {
      "id": "task",
      "text": "How can an agent profile local Parquet and screen for personal information?",
      "split": "development",
      "intent": "task",
      "claims": [
        "pii",
        "checks"
      ]
    },
    {
      "id": "unseen",
      "text": "CSV 결측값과 중복을 로컬에서 검사하는 MCP 도구는?",
      "split": "holdout",
      "intent": "task",
      "claims": [
        "checks",
        "limits"
      ]
    }
  ],
  "policy": {
    "mode": "propose",
    "preserve": [
      "github_about",
      "readme_banner"
    ],
    "publication": "public-input-only"
  }
}
