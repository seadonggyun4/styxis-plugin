{
  "schema_version": 1,
  "product": {
    "id": "truthound-local",
    "name": "Truthound",
    "category": "Local data validation MCP backed by a data quality framework",
    "version": "Core 3.3.1 / Local 0.1.7"
  },
  "evidence": [
    {
      "id": "guide",
      "url": "https://truthound.netlify.app/en/guides/data-validation-mcp/",
      "label": "Published Local MCP guide",
      "visibility": "public"
    },
    {
      "id": "example",
      "url": "https://truthound.netlify.app/assets/examples/local-mcp-3.3.1.json",
      "label": "Synthetic Local execution receipt",
      "visibility": "public"
    },
    {
      "id": "comparison",
      "url": "https://truthound.netlify.app/en/guides/gx-parity/",
      "label": "Bounded Great Expectations comparison",
      "visibility": "public"
    }
  ],
  "claims": [
    {
      "id": "identity",
      "statement": "Truthound is a data quality framework. Truthound Local exposes a bounded set of local file checks through MCP.",
      "kind": "identity",
      "evidence": [
        "guide",
        "comparison"
      ]
    },
    {
      "id": "checks",
      "statement": "Truthound Local checks missing values and duplicate rows in approved CSV and Parquet files.",
      "kind": "capability",
      "evidence": [
        "guide",
        "example"
      ]
    },
    {
      "id": "limits",
      "statement": "Local does not accept custom schema or rule inputs and does not establish compatibility with Great Expectations configuration formats.",
      "kind": "limitation",
      "evidence": [
        "guide"
      ]
    },
    {
      "id": "pii",
      "statement": "Local provides aggregate profiling and sampled PII screening; a clean screening result does not establish absence of PII.",
      "kind": "capability",
      "evidence": [
        "guide",
        "example"
      ]
    },
    {
      "id": "consent",
      "kind": "limitation",
      "statement": "Installing the Local plugin grants no data access. Local file calls require explicit directory consent and host MCP configuration.",
      "evidence": [
        "guide"
      ]
    },
    {
      "id": "exposure",
      "kind": "limitation",
      "statement": "Raw dataset values are excluded from Local tool results, but file paths, column names and aggregate statistics can reach the host model provider.",
      "evidence": [
        "guide"
      ]
    },
    {
      "id": "scope",
      "kind": "limitation",
      "statement": "Truthound Local validates tabular datasets; these checks do not evaluate the correctness of LLM answers or establish legal compliance.",
      "evidence": [
        "guide"
      ]
    }
  ],
  "targets": [
    {
      "id": "gx-parity-en",
