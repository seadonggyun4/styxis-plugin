# Copy to .env.local and chmod 600. Never source this file as a shell script.
# Absolute local paths; no interpolation, shell commands or inline comments.
BESTIES_ENV_VERSION=1
BESTIES_FACTS_PATH=
BESTIES_STUDY_DIR=
BESTIES_OUTPUT_DIR=
BESTIES_PROJECT_PREFIX=truthound-geo-no
BESTIES_VERCEL_SCOPE=
BESTIES_NETLIFY_TEAM=
# Optional. Prefer existing official CLI login locally; secret injection in CI.
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=

# Public origins and frozen publication range
BESTIES_VERCEL_BASELINE_URL=https://truthound-geo-baseline.vercel.app
BESTIES_NETLIFY_BASELINE_URL=https://truthound-geo-baseline.netlify.app
BESTIES_VERCEL_PERSONA_URL_TEMPLATE=https://truthound-geo-no-{number}.vercel.app
BESTIES_NETLIFY_PERSONA_URL_TEMPLATE=https://truthound-geo-no-{number}.netlify.app
BESTIES_PERSONA_FIRST=1
BESTIES_PERSONA_LAST=16
BESTIES_LAYOUT_LOCK_PATH=
